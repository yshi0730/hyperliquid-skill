# Required: Your private key for signing transactions
# Must be a wallet registered on Hyperliquid (deposit funds to register)
HYPERLIQUID_PRIVATE_KEY=0x1234567890abcdef...

# Optional: Account address (if using agent/API wallet mode)
# If not set, uses the address derived from HYPERLIQUID_PRIVATE_KEY
# HYPERLIQUID_ACCOUNT_ADDRESS=0xYourTradingAccountAddress...

# Optional: Use testnet instead of mainnet (true/false)
HYPERLIQUID_TESTNET=false

# Optional: Vault address (if trading from a vault)
# HYPERLIQUID_VAULT_ADDRESS=0xVaultAddress...
